# Copier vers .env.prod (non versionné) puis remplir AVANT docker compose prod.
# Interdit : Admin1234!, consulos_dev_pass, redis_dev_pass, minioadmin, minioadmin123
# Contrôle : .\scripts\check-prod-secrets.ps1
#
# Vault / secret manager : injecter les mêmes clés (POSTGRES_PASSWORD, REDIS_PASSWORD,
# MINIO_ACCESS_KEY, MINIO_SECRET_KEY, GRAFANA_ADMIN_PASSWORD) au lieu d'un fichier plat.

POSTGRES_DB=consulos
POSTGRES_USER=consulos
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=consulos-docs

CORS_ALLOWED_ORIGINS=https://consulos.local

# Observabilité (docker-compose.observability.yml) — Grafana sur :3011 (pas 3000/3001)
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# ConsulOS — ne jamais versionner secrets, clés ou données sensibles
# =============================================================================

# --- Variables d'environnement (garder uniquement les *.example) ---
.env
.env.*
!.env.example
!.env.*.example

# --- Clés cryptographiques & certificats ---
secrets/
keys/
# Clés JWT locales (préférer secrets/ ou JWT_*_KEY_PATH)
**/jwt-dev/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
# Clés factices des tests unitaires uniquement
!**/src/test/resources/**/*.pem

# --- Fichiers d'identifiants cloud / API ---
credentials.json
credentials/
*credentials*.json
service-account*.json
*-service-account.json
.aws/
.gcp/
.azure/

# --- SSH / GPG ---
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.gpg
*.asc
!*.asc.example

# --- Mots de passe & tokens locaux ---
*.secret
*.token
auth.json
.netrc
.npmrc
!.npmrc.example

# --- Overrides Docker locaux (souvent avec secrets prod) ---
docker-compose.override.yml
docker-compose.local.yml
docker-compose.*.local.yml

# --- Sauvegardes & dumps BDD ---
*.sql.gz
*.sql.dump
*.dump
backups/
data/
postgres_data/

# =============================================================================
# Build & dépendances
# =============================================================================

# Java / Maven
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Node / frontend
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/.turbo/
**/.parcel-cache/

# =============================================================================
# Tests & rapports
# =============================================================================
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/
**/coverage/
**/.nyc_output/
**/jacoco.exec

# =============================================================================
# Logs & fichiers temporaires
# =============================================================================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.swp
*.swo
*~

# =============================================================================
# IDE & OS
# =============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.project
.classpath
.settings/
*.sublime-*
.DS_Store
Thumbs.db
Desktop.ini

# =============================================================================
# Cursor / agents (garder .cursorrules à la racine)
# =============================================================================
.cursor/
!.cursorrules

# =============================================================================
# Fichiers locaux Vite / outils
# =============================================================================
*.local

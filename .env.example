# PostgreSQL
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5433/consulos_dev
POSTGRES_USER=consulos
POSTGRES_PASSWORD=consulos_dev_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=consulos

# JWT (RS256) — générer avec : .\scripts\generate-jwt-keys.ps1
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Mail — MailHog ConsulOS (UI http://localhost:8026, SMTP 1026)
# Évite le conflit avec Mailpit eConsulat sur 1025/8025
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@consulos.local
# Lien dans le mail portail (adapter le port Vite si besoin)
# CONSULOS_PORTAL_URL=http://localhost:3010/portal/ouvrir?token=

# SMS RDV (optionnel Phase 2) — désactivé par défaut
# CONSULOS_SMS_ENABLED=true
# CONSULOS_SMS_PROVIDER=log
# CONSULOS_SMS_FROM=+33123456789
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Paiement en ligne (optionnel Phase 3)
# CONSULOS_PAYMENT_ENABLED=true
# CONSULOS_PAYMENT_PROVIDER=log
# Simulateur local (défaut) :
# CONSULOS_PAYMENT_SIMULATE_URL=http://localhost:3010/caisse/paiement-en-ligne
# Stripe réel (Checkout Sessions + webhook signé) :
# CONSULOS_PAYMENT_PROVIDER=stripe-sdk
# CONSULOS_PAYMENT_SUCCESS_URL=http://localhost:3010/caisse/paiement-en-ligne
# CONSULOS_PAYMENT_CANCEL_URL=http://localhost:3010/caisse?payment=cancel
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OCR documents (optionnel Phase 3)
# CONSULOS_OCR_ENABLED=true
# CONSULOS_OCR_PROVIDER=log
# Stub riche pour pré-remplissage formulaires :
# CONSULOS_OCR_PROVIDER=structured-log
# Tesseract réel (Tess4J) — télécharger les modèles : .\scripts\download-tessdata.ps1
# CONSULOS_OCR_PROVIDER=tesseract
# CONSULOS_OCR_TESSERACT_DATAPATH=./tessdata
# CONSULOS_OCR_TESSERACT_LANGUAGE=fra+eng
# CONSULOS_OCR_TESSERACT_DPI=300

# Réseau multi-postes (Phase 3 Vague A)
# CONSULOS_RESEAU_ENABLED=true

# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

# SSL (production)
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5433/consulos_dev
POSTGRES_USER=consulos
POSTGRES_PASSWORD=consulos_dev_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=consulos

# JWT (RS256) — générer avec : .\scripts\generate-jwt-keys.ps1
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS RDV (optionnel Phase 2) — désactivé par défaut
# CONSULOS_SMS_ENABLED=true
# CONSULOS_SMS_PROVIDER=log
# CONSULOS_SMS_FROM=+33123456789
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

# SSL (production)
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12
